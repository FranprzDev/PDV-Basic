# Config del entorno de la app web.
# En la práctica alcanza con el .env de la raíz (ver ../../.env.example).
# Generá el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar-esto-por-uno-aleatorio

# Dev: 3001. Prod (compose): 3111.
BASE_URL=http://localhost:3001
NEXT_PUBLIC_BASE_URL=http://localhost:3001
